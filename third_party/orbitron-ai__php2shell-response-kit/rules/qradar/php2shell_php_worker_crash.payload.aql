// PHP Worker or Apache Child Crashed With Memory Corruption Signal (possible php2shell exploitation attempt)
// Sigma id: f87775e3-8592-4172-8149-15e966b73151 | level: medium | status: experimental
// Target: QRadar AQL - payload search (no custom properties needed, slower)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%exited on signal 11%' OR LOWER(UTF8(payload)) LIKE '%exited on signal 6%' OR LOWER(UTF8(payload)) LIKE '%exited on signal 7%' OR LOWER(UTF8(payload)) LIKE '%exit signal segmentation fault%' OR LOWER(UTF8(payload)) LIKE '%exit signal aborted%' OR LOWER(UTF8(payload)) LIKE '%exit signal bus error%')
