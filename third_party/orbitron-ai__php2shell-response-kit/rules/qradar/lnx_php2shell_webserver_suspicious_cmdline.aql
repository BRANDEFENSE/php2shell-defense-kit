// PHP or Web Server Process Executes Reverse Shell or Reconnaissance Command Line (php2shell post-exploitation)
// Sigma id: 98f449aa-52b5-41df-b9d1-c81b3a1c78fe | level: critical | status: experimental
// Target: QRadar AQL - field-based (requires Sysmon/EDR DSM custom properties)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Parent Process Path") LIKE '%php-fpm%' OR LOWER("Parent Process Path") LIKE '%php-cgi%' OR LOWER("Parent Process Path") LIKE '%lsphp%') OR (LOWER("Parent Process Path") LIKE '%httpd' OR LOWER("Parent Process Path") LIKE '%apache2')) AND (LOWER(Command) LIKE '%/dev/tcp/%' OR LOWER(Command) LIKE '%/dev/udp/%' OR LOWER(Command) LIKE '%mkfifo%' OR LOWER(Command) LIKE '%fsockopen%' OR LOWER(Command) LIKE '%bash -i%' OR LOWER(Command) LIKE '%sh -i%' OR LOWER(Command) LIKE '%nc -e%' OR LOWER(Command) LIKE '%ncat -e%' OR LOWER(Command) LIKE '%socat exec%' OR LOWER(Command) LIKE '%base64 -d%' OR LOWER(Command) LIKE '%base64 --decode%' OR LOWER(Command) LIKE '%| sh%' OR LOWER(Command) LIKE '%|sh%' OR LOWER(Command) LIKE '%| bash%' OR LOWER(Command) LIKE '%|bash%' OR LOWER(Command) LIKE '%chmod +x%' OR LOWER(Command) LIKE '%/dev/shm/%' OR LOWER(Command) LIKE '%/etc/passwd%' OR LOWER(Command) LIKE '%/etc/shadow%' OR LOWER(Command) LIKE '%uname -a%' OR LOWER(Command) LIKE '%whoami%')
