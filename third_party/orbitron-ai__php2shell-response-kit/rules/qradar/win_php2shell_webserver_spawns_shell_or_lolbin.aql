// PHP or Web Server Process Spawns Shell or LOLBin on Windows (php2shell post-exploitation)
// Sigma id: 0c88ffdb-d35f-481e-a5d6-2be5229f289f | level: high | status: experimental
// Target: QRadar AQL - field-based (requires Sysmon/EDR DSM custom properties)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%php-cgi.exe' OR LOWER("Parent Process Path") LIKE '%php.exe' OR LOWER("Parent Process Path") LIKE '%httpd.exe' OR LOWER("Parent Process Path") LIKE '%w3wp.exe') AND ((LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe' OR LOWER("Process Path") LIKE '%\certutil.exe' OR LOWER("Process Path") LIKE '%\bitsadmin.exe' OR LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Path") LIKE '%\regsvr32.exe' OR LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\whoami.exe' OR LOWER("Process Path") LIKE '%\net.exe' OR LOWER("Process Path") LIKE '%\net1.exe' OR LOWER("Process Path") LIKE '%\systeminfo.exe' OR LOWER("Process Path") LIKE '%\ipconfig.exe' OR LOWER("Process Path") LIKE '%\nltest.exe' OR LOWER("Process Path") LIKE '%\tasklist.exe' OR LOWER("Process Path") LIKE '%\quser.exe' OR LOWER("Process Path") LIKE '%\curl.exe') OR (LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe' OR LOWER("Process Name") LIKE '%\certutil.exe' OR LOWER("Process Name") LIKE '%\bitsadmin.exe' OR LOWER("Process Name") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\regsvr32.exe' OR LOWER("Process Name") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\whoami.exe' OR LOWER("Process Name") LIKE '%\net.exe' OR LOWER("Process Name") LIKE '%\net1.exe' OR LOWER("Process Name") LIKE '%\systeminfo.exe' OR LOWER("Process Name") LIKE '%\ipconfig.exe' OR LOWER("Process Name") LIKE '%\nltest.exe' OR LOWER("Process Name") LIKE '%\tasklist.exe' OR LOWER("Process Name") LIKE '%\quser.exe' OR LOWER("Process Name") LIKE '%\curl.exe'))
