// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Linux)
// Sigma id: d4124a4d-73b3-4186-a15a-7aef38e85db3 | level: medium | status: experimental
// Target: QRadar AQL - field-based (requires Sysmon/EDR DSM custom properties)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=11 AND (((LOWER("Process Path") LIKE '%php-fpm%' OR LOWER("Process Path") LIKE '%php-cgi%' OR LOWER("Process Path") LIKE '%lsphp%') OR (LOWER("Process Name") LIKE '%php-fpm%' OR LOWER("Process Name") LIKE '%php-cgi%' OR LOWER("Process Name") LIKE '%lsphp%')) OR ((LOWER("Process Path") LIKE '%httpd' OR LOWER("Process Path") LIKE '%apache2') OR (LOWER("Process Name") LIKE '%httpd' OR LOWER("Process Name") LIKE '%apache2'))) AND (LOWER(Filename) LIKE '/var/www/%' OR LOWER(Filename) LIKE '/srv/%' OR LOWER(Filename) LIKE '/usr/share/nginx/%' OR LOWER(Filename) LIKE '/home/%') AND (LOWER(Filename) LIKE '%.php' OR LOWER(Filename) LIKE '%.phtml' OR LOWER(Filename) LIKE '%.phar' OR LOWER(Filename) LIKE '%.php5' OR LOWER(Filename) LIKE '%.php7' OR LOWER(Filename) LIKE '%.pht' OR LOWER(Filename) LIKE '%/.user.ini' OR LOWER(Filename) LIKE '%/.htaccess')
