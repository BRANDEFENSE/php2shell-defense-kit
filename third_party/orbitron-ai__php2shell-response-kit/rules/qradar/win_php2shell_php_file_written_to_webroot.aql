// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Windows)
// Sigma id: e4ae4b72-d043-4906-ab1d-d7cfe24ed018 | level: medium | status: experimental
// Target: QRadar AQL - field-based (requires Sysmon/EDR DSM custom properties)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%php-cgi.exe' OR LOWER("Process Path") LIKE '%php.exe' OR LOWER("Process Path") LIKE '%httpd.exe' OR LOWER("Process Path") LIKE '%w3wp.exe') OR (LOWER("Process Name") LIKE '%php-cgi.exe' OR LOWER("Process Name") LIKE '%php.exe' OR LOWER("Process Name") LIKE '%httpd.exe' OR LOWER("Process Name") LIKE '%w3wp.exe')) AND (LOWER(Filename) LIKE '%\inetpub\%' OR LOWER(Filename) LIKE '%\htdocs\%' OR LOWER(Filename) LIKE '%\www\%' OR LOWER(Filename) LIKE '%\wwwroot\%') AND (LOWER(Filename) LIKE '%.php' OR LOWER(Filename) LIKE '%.phtml' OR LOWER(Filename) LIKE '%.phar' OR LOWER(Filename) LIKE '%.aspx' OR LOWER(Filename) LIKE '%.ashx' OR LOWER(Filename) LIKE '%\.user.ini' OR LOWER(Filename) LIKE '%\.htaccess' OR LOWER(Filename) LIKE '%\web.config')
