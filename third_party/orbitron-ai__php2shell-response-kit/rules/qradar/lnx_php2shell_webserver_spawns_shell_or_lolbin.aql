// PHP or Web Server Process Spawns Shell, Interpreter or Download Tool (php2shell post-exploitation)
// Sigma id: 120e77fd-91e2-4cdd-ba44-6f2b5fad42c4 | level: high | status: experimental
// Target: QRadar AQL - field-based (requires Sysmon/EDR DSM custom properties)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Parent Process Path") LIKE '%php-fpm%' OR LOWER("Parent Process Path") LIKE '%php-cgi%' OR LOWER("Parent Process Path") LIKE '%lsphp%') OR (LOWER("Parent Process Path") LIKE '%httpd' OR LOWER("Parent Process Path") LIKE '%apache2')) AND ((LOWER("Process Path") LIKE '%/sh' OR LOWER("Process Path") LIKE '%/bash' OR LOWER("Process Path") LIKE '%/dash' OR LOWER("Process Path") LIKE '%/zsh' OR LOWER("Process Path") LIKE '%/ksh' OR LOWER("Process Path") LIKE '%/ash' OR LOWER("Process Path") LIKE '%/busybox' OR LOWER("Process Path") LIKE '%/python' OR LOWER("Process Path") LIKE '%/python2' OR LOWER("Process Path") LIKE '%/python3' OR LOWER("Process Path") LIKE '%/perl' OR LOWER("Process Path") LIKE '%/ruby' OR LOWER("Process Path") LIKE '%/nc' OR LOWER("Process Path") LIKE '%/ncat' OR LOWER("Process Path") LIKE '%/netcat' OR LOWER("Process Path") LIKE '%/socat' OR LOWER("Process Path") LIKE '%/curl' OR LOWER("Process Path") LIKE '%/wget' OR LOWER("Process Path") LIKE '%/telnet' OR LOWER("Process Path") LIKE '%/openssl' OR LOWER("Process Path") LIKE '%/base64' OR LOWER("Process Path") LIKE '%/whoami' OR LOWER("Process Path") LIKE '%/id' OR LOWER("Process Path") LIKE '%/uname' OR LOWER("Process Path") LIKE '%/hostname' OR LOWER("Process Path") LIKE '%/ifconfig' OR LOWER("Process Path") LIKE '%/crontab' OR LOWER("Process Path") LIKE '%/mkfifo' OR LOWER("Process Path") LIKE '%/nohup') OR (LOWER("Process Name") LIKE '%/sh' OR LOWER("Process Name") LIKE '%/bash' OR LOWER("Process Name") LIKE '%/dash' OR LOWER("Process Name") LIKE '%/zsh' OR LOWER("Process Name") LIKE '%/ksh' OR LOWER("Process Name") LIKE '%/ash' OR LOWER("Process Name") LIKE '%/busybox' OR LOWER("Process Name") LIKE '%/python' OR LOWER("Process Name") LIKE '%/python2' OR LOWER("Process Name") LIKE '%/python3' OR LOWER("Process Name") LIKE '%/perl' OR LOWER("Process Name") LIKE '%/ruby' OR LOWER("Process Name") LIKE '%/nc' OR LOWER("Process Name") LIKE '%/ncat' OR LOWER("Process Name") LIKE '%/netcat' OR LOWER("Process Name") LIKE '%/socat' OR LOWER("Process Name") LIKE '%/curl' OR LOWER("Process Name") LIKE '%/wget' OR LOWER("Process Name") LIKE '%/telnet' OR LOWER("Process Name") LIKE '%/openssl' OR LOWER("Process Name") LIKE '%/base64' OR LOWER("Process Name") LIKE '%/whoami' OR LOWER("Process Name") LIKE '%/id' OR LOWER("Process Name") LIKE '%/uname' OR LOWER("Process Name") LIKE '%/hostname' OR LOWER("Process Name") LIKE '%/ifconfig' OR LOWER("Process Name") LIKE '%/crontab' OR LOWER("Process Name") LIKE '%/mkfifo' OR LOWER("Process Name") LIKE '%/nohup')) AND (NOT((LOWER(Command) LIKE '%sendmail%' OR LOWER(Command) LIKE '%postdrop%' OR LOWER(Command) LIKE '%exim%' OR LOWER(Command) LIKE '%msmtp%')))
