| tstats summariesonly=false allow_old_summaries=true fillnull_value="null" count min(_time) as firstTime max(_time) as lastTime from datamodel=Endpoint.Processes where Processes.parent_process_path IN ("*php-fpm*", "*php-cgi*", "*lsphp*") OR Processes.parent_process_path IN ("*httpd", "*apache2") Processes.process IN ("*/dev/tcp/*", "*/dev/udp/*", "*mkfifo*", "*fsockopen*", "*bash -i*", "*sh -i*", "*nc -e*", "*ncat -e*", "*socat exec*", "*base64 -d*", "*base64 --decode*", "*| sh*", "*|sh*", "*| bash*", "*|bash*", "*chmod +x*", "*/dev/shm/*", "*/etc/passwd*", "*/etc/shadow*", "*uname -a*", "*whoami*") by Processes.process Processes.dest Processes.process_current_directory Processes.process_path Processes.process_integrity_level Processes.original_file_name Processes.parent_process Processes.parent_process_path Processes.parent_process_guid Processes.parent_process_id Processes.process_guid Processes.process_id Processes.user | `drop_dm_object_name(Processes)` | convert timeformat="%Y-%m-%dT%H:%M:%S" ctime(firstTime) | convert timeformat="%Y-%m-%dT%H:%M:%S" ctime(lastTime) 
