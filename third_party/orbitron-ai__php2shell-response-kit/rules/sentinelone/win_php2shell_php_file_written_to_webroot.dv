// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Windows)
// Sigma id: e4ae4b72-d043-4906-ab1d-d7cfe24ed018 | level: medium | status: experimental
// Target: SentinelOne Deep Visibility query language (legacy DV)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
ObjectType = "File" AND (EndpointOS = "windows" AND ((SrcProcImagePath endswithCIS "php-cgi.exe" OR SrcProcImagePath endswithCIS "php.exe" OR SrcProcImagePath endswithCIS "httpd.exe" OR SrcProcImagePath endswithCIS "w3wp.exe") AND (TgtFilePath containsCIS "\inetpub\" OR TgtFilePath containsCIS "\htdocs\" OR TgtFilePath containsCIS "\www\" OR TgtFilePath containsCIS "\wwwroot\") AND (TgtFilePath endswithCIS ".php" OR TgtFilePath endswithCIS ".phtml" OR TgtFilePath endswithCIS ".phar" OR TgtFilePath endswithCIS ".aspx" OR TgtFilePath endswithCIS ".ashx" OR TgtFilePath endswithCIS "\.user.ini" OR TgtFilePath endswithCIS "\.htaccess" OR TgtFilePath endswithCIS "\web.config")))
