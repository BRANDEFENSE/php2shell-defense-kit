// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Linux)
// Sigma id: d4124a4d-73b3-4186-a15a-7aef38e85db3 | level: medium | status: experimental
// Target: SentinelOne PowerQuery (Singularity Data Lake / Deep Visibility PQ)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
// WARNING: the PQ backend approximates 'endswith' with 'contains' (e.g. '/sh' also matches '/ssh').
// Prefer the .dv variant or tighten the patterns after baselining.
event.category="file" and (endpoint.os="linux" and (((src.process.image.path contains "php-fpm" or src.process.image.path contains "php-cgi" or src.process.image.path contains "lsphp") or (src.process.image.path contains "httpd" or src.process.image.path contains "apache2")) and (tgt.file.path contains "/var/www/" or tgt.file.path contains "/srv/" or tgt.file.path contains "/usr/share/nginx/" or tgt.file.path contains "/home/") and (tgt.file.path contains ".php" or tgt.file.path contains ".phtml" or tgt.file.path contains ".phar" or tgt.file.path contains ".php5" or tgt.file.path contains ".php7" or tgt.file.path contains ".pht" or tgt.file.path contains "/.user.ini" or tgt.file.path contains "/.htaccess")))
