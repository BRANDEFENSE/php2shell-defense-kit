// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Windows)
// Sigma id: e4ae4b72-d043-4906-ab1d-d7cfe24ed018 | level: medium | status: experimental
// Target: SentinelOne PowerQuery (Singularity Data Lake / Deep Visibility PQ)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
// WARNING: the PQ backend approximates 'endswith' with 'contains' (e.g. '/sh' also matches '/ssh').
// Prefer the .dv variant or tighten the patterns after baselining.
event.category="file" and (endpoint.os="windows" and ((src.process.image.path contains "php-cgi.exe" or src.process.image.path contains "php.exe" or src.process.image.path contains "httpd.exe" or src.process.image.path contains "w3wp.exe") and (tgt.file.path contains "\\inetpub\\" or tgt.file.path contains "\\htdocs\\" or tgt.file.path contains "\\www\\" or tgt.file.path contains "\\wwwroot\\") and (tgt.file.path contains ".php" or tgt.file.path contains ".phtml" or tgt.file.path contains ".phar" or tgt.file.path contains ".aspx" or tgt.file.path contains ".ashx" or tgt.file.path contains "\\.user.ini" or tgt.file.path contains "\\.htaccess" or tgt.file.path contains "\\web.config")))
