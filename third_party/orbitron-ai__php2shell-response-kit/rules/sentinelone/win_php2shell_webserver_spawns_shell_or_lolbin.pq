// PHP or Web Server Process Spawns Shell or LOLBin on Windows (php2shell post-exploitation)
// Sigma id: 0c88ffdb-d35f-481e-a5d6-2be5229f289f | level: high | status: experimental
// Target: SentinelOne PowerQuery (Singularity Data Lake / Deep Visibility PQ)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
// WARNING: the PQ backend approximates 'endswith' with 'contains' (e.g. '/sh' also matches '/ssh').
// Prefer the .dv variant or tighten the patterns after baselining.
event.type="Process Creation" and (endpoint.os="windows" and ((src.process.image.path contains "php-cgi.exe" or src.process.image.path contains "php.exe" or src.process.image.path contains "httpd.exe" or src.process.image.path contains "w3wp.exe") and (tgt.process.image.path contains "\\cmd.exe" or tgt.process.image.path contains "\\powershell.exe" or tgt.process.image.path contains "\\pwsh.exe" or tgt.process.image.path contains "\\certutil.exe" or tgt.process.image.path contains "\\bitsadmin.exe" or tgt.process.image.path contains "\\mshta.exe" or tgt.process.image.path contains "\\rundll32.exe" or tgt.process.image.path contains "\\regsvr32.exe" or tgt.process.image.path contains "\\wscript.exe" or tgt.process.image.path contains "\\cscript.exe" or tgt.process.image.path contains "\\whoami.exe" or tgt.process.image.path contains "\\net.exe" or tgt.process.image.path contains "\\net1.exe" or tgt.process.image.path contains "\\systeminfo.exe" or tgt.process.image.path contains "\\ipconfig.exe" or tgt.process.image.path contains "\\nltest.exe" or tgt.process.image.path contains "\\tasklist.exe" or tgt.process.image.path contains "\\quser.exe" or tgt.process.image.path contains "\\curl.exe")))
