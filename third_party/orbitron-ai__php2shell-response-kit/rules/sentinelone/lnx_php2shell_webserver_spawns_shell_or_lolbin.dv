// PHP or Web Server Process Spawns Shell, Interpreter or Download Tool (php2shell post-exploitation)
// Sigma id: 120e77fd-91e2-4cdd-ba44-6f2b5fad42c4 | level: high | status: experimental
// Target: SentinelOne Deep Visibility query language (legacy DV)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
EventType = "Process Creation" AND (EndpointOS = "linux" AND (((SrcProcImagePath containsCIS "php-fpm" OR SrcProcImagePath containsCIS "php-cgi" OR SrcProcImagePath containsCIS "lsphp") OR (SrcProcImagePath endswithCIS "httpd" OR SrcProcImagePath endswithCIS "apache2")) AND (TgtProcImagePath endswithCIS "/sh" OR TgtProcImagePath endswithCIS "/bash" OR TgtProcImagePath endswithCIS "/dash" OR TgtProcImagePath endswithCIS "/zsh" OR TgtProcImagePath endswithCIS "/ksh" OR TgtProcImagePath endswithCIS "/ash" OR TgtProcImagePath endswithCIS "/busybox" OR TgtProcImagePath endswithCIS "/python" OR TgtProcImagePath endswithCIS "/python2" OR TgtProcImagePath endswithCIS "/python3" OR TgtProcImagePath endswithCIS "/perl" OR TgtProcImagePath endswithCIS "/ruby" OR TgtProcImagePath endswithCIS "/nc" OR TgtProcImagePath endswithCIS "/ncat" OR TgtProcImagePath endswithCIS "/netcat" OR TgtProcImagePath endswithCIS "/socat" OR TgtProcImagePath endswithCIS "/curl" OR TgtProcImagePath endswithCIS "/wget" OR TgtProcImagePath endswithCIS "/telnet" OR TgtProcImagePath endswithCIS "/openssl" OR TgtProcImagePath endswithCIS "/base64" OR TgtProcImagePath endswithCIS "/whoami" OR TgtProcImagePath endswithCIS "/id" OR TgtProcImagePath endswithCIS "/uname" OR TgtProcImagePath endswithCIS "/hostname" OR TgtProcImagePath endswithCIS "/ifconfig" OR TgtProcImagePath endswithCIS "/crontab" OR TgtProcImagePath endswithCIS "/mkfifo" OR TgtProcImagePath endswithCIS "/nohup") AND (NOT (TgtProcCmdLine containsCIS "sendmail" OR TgtProcCmdLine containsCIS "postdrop" OR TgtProcCmdLine containsCIS "exim" OR TgtProcCmdLine containsCIS "msmtp"))))
