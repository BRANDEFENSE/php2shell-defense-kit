// PHP or Web Server Process Executes Reverse Shell or Reconnaissance Command Line (php2shell post-exploitation)
// Sigma id: 98f449aa-52b5-41df-b9d1-c81b3a1c78fe | level: critical | status: experimental
// Target: SentinelOne Deep Visibility query language (legacy DV)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
EventType = "Process Creation" AND (EndpointOS = "linux" AND (((SrcProcImagePath containsCIS "php-fpm" OR SrcProcImagePath containsCIS "php-cgi" OR SrcProcImagePath containsCIS "lsphp") OR (SrcProcImagePath endswithCIS "httpd" OR SrcProcImagePath endswithCIS "apache2")) AND (TgtProcCmdLine containsCIS "/dev/tcp/" OR TgtProcCmdLine containsCIS "/dev/udp/" OR TgtProcCmdLine containsCIS "mkfifo" OR TgtProcCmdLine containsCIS "fsockopen" OR TgtProcCmdLine containsCIS "bash -i" OR TgtProcCmdLine containsCIS "sh -i" OR TgtProcCmdLine containsCIS "nc -e" OR TgtProcCmdLine containsCIS "ncat -e" OR TgtProcCmdLine containsCIS "socat exec" OR TgtProcCmdLine containsCIS "base64 -d" OR TgtProcCmdLine containsCIS "base64 --decode" OR TgtProcCmdLine containsCIS "| sh" OR TgtProcCmdLine containsCIS "|sh" OR TgtProcCmdLine containsCIS "| bash" OR TgtProcCmdLine containsCIS "|bash" OR TgtProcCmdLine containsCIS "chmod +x" OR TgtProcCmdLine containsCIS "/dev/shm/" OR TgtProcCmdLine containsCIS "/etc/passwd" OR TgtProcCmdLine containsCIS "/etc/shadow" OR TgtProcCmdLine containsCIS "uname -a" OR TgtProcCmdLine containsCIS "whoami")))
