// PHP or Web Server Process Spawns Shell, Interpreter or Download Tool (php2shell post-exploitation)
// Sigma id: 120e77fd-91e2-4cdd-ba44-6f2b5fad42c4 | level: high | status: experimental
// Target: SentinelOne PowerQuery (Singularity Data Lake / Deep Visibility PQ)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
// WARNING: the PQ backend approximates 'endswith' with 'contains' (e.g. '/sh' also matches '/ssh').
// Prefer the .dv variant or tighten the patterns after baselining.
event.type="Process Creation" and (endpoint.os="linux" and (((src.process.image.path contains "php-fpm" or src.process.image.path contains "php-cgi" or src.process.image.path contains "lsphp") or (src.process.image.path contains "httpd" or src.process.image.path contains "apache2")) and (tgt.process.image.path contains "/sh" or tgt.process.image.path contains "/bash" or tgt.process.image.path contains "/dash" or tgt.process.image.path contains "/zsh" or tgt.process.image.path contains "/ksh" or tgt.process.image.path contains "/ash" or tgt.process.image.path contains "/busybox" or tgt.process.image.path contains "/python" or tgt.process.image.path contains "/python2" or tgt.process.image.path contains "/python3" or tgt.process.image.path contains "/perl" or tgt.process.image.path contains "/ruby" or tgt.process.image.path contains "/nc" or tgt.process.image.path contains "/ncat" or tgt.process.image.path contains "/netcat" or tgt.process.image.path contains "/socat" or tgt.process.image.path contains "/curl" or tgt.process.image.path contains "/wget" or tgt.process.image.path contains "/telnet" or tgt.process.image.path contains "/openssl" or tgt.process.image.path contains "/base64" or tgt.process.image.path contains "/whoami" or tgt.process.image.path contains "/id" or tgt.process.image.path contains "/uname" or tgt.process.image.path contains "/hostname" or tgt.process.image.path contains "/ifconfig" or tgt.process.image.path contains "/crontab" or tgt.process.image.path contains "/mkfifo" or tgt.process.image.path contains "/nohup") and (not (tgt.process.cmdline contains "sendmail" or tgt.process.cmdline contains "postdrop" or tgt.process.cmdline contains "exim" or tgt.process.cmdline contains "msmtp"))))
