// PHP or Web Server Process Executes Reverse Shell or Reconnaissance Command Line (php2shell post-exploitation)
// Sigma id: 98f449aa-52b5-41df-b9d1-c81b3a1c78fe | level: critical | status: experimental
// Target: SentinelOne PowerQuery (Singularity Data Lake / Deep Visibility PQ)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
// WARNING: the PQ backend approximates 'endswith' with 'contains' (e.g. '/sh' also matches '/ssh').
// Prefer the .dv variant or tighten the patterns after baselining.
event.type="Process Creation" and (endpoint.os="linux" and (((src.process.image.path contains "php-fpm" or src.process.image.path contains "php-cgi" or src.process.image.path contains "lsphp") or (src.process.image.path contains "httpd" or src.process.image.path contains "apache2")) and (tgt.process.cmdline contains "/dev/tcp/" or tgt.process.cmdline contains "/dev/udp/" or tgt.process.cmdline contains "mkfifo" or tgt.process.cmdline contains "fsockopen" or tgt.process.cmdline contains "bash -i" or tgt.process.cmdline contains "sh -i" or tgt.process.cmdline contains "nc -e" or tgt.process.cmdline contains "ncat -e" or tgt.process.cmdline contains "socat exec" or tgt.process.cmdline contains "base64 -d" or tgt.process.cmdline contains "base64 --decode" or tgt.process.cmdline contains "| sh" or tgt.process.cmdline contains "|sh" or tgt.process.cmdline contains "| bash" or tgt.process.cmdline contains "|bash" or tgt.process.cmdline contains "chmod +x" or tgt.process.cmdline contains "/dev/shm/" or tgt.process.cmdline contains "/etc/passwd" or tgt.process.cmdline contains "/etc/shadow" or tgt.process.cmdline contains "uname -a" or tgt.process.cmdline contains "whoami")))
