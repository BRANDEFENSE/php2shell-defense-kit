// PHP or Web Server Process Writes Executable Script or Per-Directory Config to Web Root (Linux)
// Sigma id: d4124a4d-73b3-4186-a15a-7aef38e85db3 | level: medium | status: experimental
// Target: SentinelOne Deep Visibility query language (legacy DV)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
ObjectType = "File" AND (EndpointOS = "linux" AND (((SrcProcImagePath containsCIS "php-fpm" OR SrcProcImagePath containsCIS "php-cgi" OR SrcProcImagePath containsCIS "lsphp") OR (SrcProcImagePath endswithCIS "httpd" OR SrcProcImagePath endswithCIS "apache2")) AND (TgtFilePath startswithCIS "/var/www/" OR TgtFilePath startswithCIS "/srv/" OR TgtFilePath startswithCIS "/usr/share/nginx/" OR TgtFilePath startswithCIS "/home/") AND (TgtFilePath endswithCIS ".php" OR TgtFilePath endswithCIS ".phtml" OR TgtFilePath endswithCIS ".phar" OR TgtFilePath endswithCIS ".php5" OR TgtFilePath endswithCIS ".php7" OR TgtFilePath endswithCIS ".pht" OR TgtFilePath endswithCIS "/.user.ini" OR TgtFilePath endswithCIS "/.htaccess")))
