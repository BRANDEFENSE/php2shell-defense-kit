// PHP or Web Server Process Spawns Shell or LOLBin on Windows (php2shell post-exploitation)
// Sigma id: 0c88ffdb-d35f-481e-a5d6-2be5229f289f | level: high | status: experimental
// Target: SentinelOne Deep Visibility query language (legacy DV)
// Generated by tools/build_rules.py - UNTESTED, review field names before use.
EventType = "Process Creation" AND (EndpointOS = "windows" AND ((SrcProcImagePath endswithCIS "php-cgi.exe" OR SrcProcImagePath endswithCIS "php.exe" OR SrcProcImagePath endswithCIS "httpd.exe" OR SrcProcImagePath endswithCIS "w3wp.exe") AND (TgtProcImagePath endswithCIS "\cmd.exe" OR TgtProcImagePath endswithCIS "\powershell.exe" OR TgtProcImagePath endswithCIS "\pwsh.exe" OR TgtProcImagePath endswithCIS "\certutil.exe" OR TgtProcImagePath endswithCIS "\bitsadmin.exe" OR TgtProcImagePath endswithCIS "\mshta.exe" OR TgtProcImagePath endswithCIS "\rundll32.exe" OR TgtProcImagePath endswithCIS "\regsvr32.exe" OR TgtProcImagePath endswithCIS "\wscript.exe" OR TgtProcImagePath endswithCIS "\cscript.exe" OR TgtProcImagePath endswithCIS "\whoami.exe" OR TgtProcImagePath endswithCIS "\net.exe" OR TgtProcImagePath endswithCIS "\net1.exe" OR TgtProcImagePath endswithCIS "\systeminfo.exe" OR TgtProcImagePath endswithCIS "\ipconfig.exe" OR TgtProcImagePath endswithCIS "\nltest.exe" OR TgtProcImagePath endswithCIS "\tasklist.exe" OR TgtProcImagePath endswithCIS "\quser.exe" OR TgtProcImagePath endswithCIS "\curl.exe")))
